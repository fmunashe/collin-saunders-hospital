APP_NAME="HMS E2E"
APP_ENV=e2e
APP_KEY=base64:lX1Ii084Y00ZJKmZSMO1166+c/S3fyIGzxng+mzvAkg=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8123

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_STACK=single
